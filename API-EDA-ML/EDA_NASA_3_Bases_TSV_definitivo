        "def auditar_df(df, nombre):\n",
        "    if df is None:\n",
        "        print(f\"[!] {nombre} no está cargado.\")\n",
        "        return\n",
        "    print(\"=\"*70)\n",
        "    print(f\"AUDITORÍA: {nombre} | Filas: {df.shape[0]} | Columnas: {df.shape[1]}\")\n",
        "    print(\"=\"*70)\n",
        "    display(df.head(3))\n",
        "\n",
        "    nulos = df.isnull().sum().sum()\n",
        "    duplicados = df.duplicated().sum()\n",
        "    astronautas_unicos = df['id_astronauta'].nunique() if 'id_astronauta' in df.columns else 'N/A'\n",
        "    print(f\"• Valores nulos totales: {nulos} | Filas duplicadas: {duplicados} | Astronautas únicos: {astronautas_unicos}\")\n",
        "\n",
        "    if 'entorno' in df.columns:\n",
        "        print(\"• Distribución por Entorno:\", df['entorno'].value_counts().to_dict())\n",
        "    if 'tipo_anomalia' in df.columns:\n",
        "        print(\"• Tipos de Anomalía:\\n\", df['tipo_anomalia'].value_counts(dropna=False))\n",
        "    print(\"\\n\")\n",
        "\n",
        "auditar_df(df_comportamiento, \"df_comportamiento (Equipo y Psicología)\")\n",
        "auditar_df(df_fisiologia_train, \"df_fisiologia_train (Fisiología con Etiquetas)\")\n",
        "auditar_df(df_fisiologia_test, \"df_fisiologia_test (Fisiología para Predecir)\")"
      ]
    },
